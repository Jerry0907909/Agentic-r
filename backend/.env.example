# 环境变量模板
# 用法：复制为同目录下的 .env，再填入真实值
#     cp backend/.env.example backend/.env
# .env 已被 .gitignore 排除，不会入库。

# ── 本地模型（Ollama）──
# 只用于词嵌入：FAISS 索引构建与查询编码都在本机完成，不产生云端调用成本。
# 问答不走本地模型 —— 全部由下方 DashScope 承担（见 系统设计.md §2.1 的模型分工）。
OLLAMA_EMBEDDING=nomic-embed-text:latest

# ── 向量库语料 ──
# medical：医疗语料（默认，由 utils/rag_index.py medical 生成）
# default：Spring Boot 课程示例语料
FAISS_INDEX_NAME=medical

# ── Neo4j 图数据库 ──
NEO4J_BOLT_URL=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填入你的Neo4j密码

# ── 云端大模型（DashScope 通义千问，OpenAI 兼容端点）──
MODEL_NAME=qwen3-max-2026-01-23
OPENAI_API_KEY=请填入你的DashScope_API_Key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── MySQL 会话持久化（F7）──
# 建库建表：cd backend && python db/init_db.py
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请填入你的MySQL密码
MYSQL_DATABASE=agentic_rag

# ── 混合检索参数（F3，见 系统设计.md §1.5）──
# 全部可配置而非硬编码：混合检索会带来额外开销（重排需对候选集逐条打分），
# 这些数字直接决定调用成本，必须能不改代码就调。
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_FUSION_TOP_K=20

# ── 重排（F3 第三段）──
# RERANK_ENABLED=false 即降级为「混合检索 + RRF 融合」结果直接返回，链路不中断
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=5
